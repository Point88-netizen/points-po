    "courant": { "$value": ["Barlow Condensed", "system-ui", "sans-serif"] },
    "donnee":  { "$value": ["DM Mono", "ui-monospace", "monospace"] }
  },
  "corps": {
    "$type": "dimension",
    "legende": { "$value": { "value": 12, "unit": "px" } },
